<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Singapore VPN Control Panel</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .vpn-card {
            background-color: #1e293b;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            width: 380px;
            padding: 30px;
            text-align: center;
            border: 1px solid #334155;
        }
        h1 {
            font-size: 20px;
            margin-bottom: 5px;
            color: #38bdf8;
        }
        .subtitle {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 25px;
        }
        .status-container {
            margin-bottom: 25px;
        }
        .status-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            background-color: #334155;
            color: #cbd5e1;
            transition: all 0.3s ease;
        }
        .status-badge.connected {
            background-color: #065f46;
            color: #34d399;
            box-shadow: 0 0 10px rgba(52, 211, 153, 0.3);
        }
        .server-info {
            background-color: #0f172a;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 25px;
            text-align: left;
            font-size: 13px;
            border: 1px solid #334155;
        }
        .server-info div {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .server-info div:last-child {
            margin-bottom: 0;
        }
        .label { color: #94a3b8; }
        .value { color: #f1f5f9; font-weight: 500; }
        .btn-connect {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 14px 0;
            width: 100%;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease-in-out;
        }
        .btn-connect:hover {
            background: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);
            transform: translateY(-1px);
        }
        .btn-connect.connected {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
        }
        .btn-connect.connected:hover {
            background: linear-gradient(135deg, #b91c1c 100%, #dc2626 0%);
        }
        .footer-text {
            font-size: 11px;
            color: #64748b;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="vpn-card">
        <h1>🇸🇬 Singapore VPN</h1>
        <div class="subtitle">Secure WireGuard Connection</div>
        
        <div class="status-container">
            <div id="statusBadge" class="status-badge">Disconnected</div>
        </div>

        <div class="server-info">
            <div><span class="label">Location:</span> <span class="value">Singapore (SG-01)</span></div>
            <div><span class="label">Server IP:</span> <span class="value" id="serverIp">139.180.x.x</span></div>
            <div><span class="label">Ping:</span> <span class="value" id="pingVal">-- ms</span></div>
            <div><span class="label">Protocol:</span> <span class="value">WireGuard UDP</span></div>
        </div>

        <button id="connectBtn" class="btn-connect" onclick="toggleVpn()">Connect VPN</button>

        <div class="footer-text">Powered by HTML5 & JavaScript</div>
    </div>

    <script>
        let isConnected = false;

        function toggleVpn() {
            const btn = document.getElementById('connectBtn');
            const badge = document.getElementById('statusBadge');
            const ping = document.getElementById('pingVal');

            isConnected = !isConnected;

            if (isConnected) {
                btn.textContent = "Disconnect";
                btn.classList.add("connected");
                badge.textContent = "Connected";
                badge.classList.add("connected");
                ping.textContent = "12 ms";
            } else {
                btn.textContent = "Connect VPN";
                btn.classList.remove("connected");
                badge.textContent = "Disconnected";
                badge.classList.remove("connected");
                ping.textContent = "-- ms";
            }
        }
    </script>
</body>
</html>
